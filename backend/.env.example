# Copy this file to .env and fill in your own keys. Never commit .env.
DATABASE_URL=sqlite:///./learnpilot.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# YouTube Data API v3 key — obtain from Google Cloud Console.
# Enable "YouTube Data API v3" for your project, then create an API key.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY_HERE

# Gemini AI provider (recommended).
# Obtain your API key from Google AI Studio: https://aistudio.google.com/apikey
# The key starts with "AIza..." for Gemini API keys.
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_MODEL=gemini-2.5-flash

# --- Optional: OpenAI-compatible provider ---
# If you prefer OpenAI or a compatible provider instead of Gemini,
# set LLM_PROVIDER=openai and configure the following.
# Leave these commented out when using Gemini.
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=YOUR_OPENAI_API_KEY_HERE
# LLM_MODEL=gpt-4o-mini
