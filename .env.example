# Frontend (Vite). Copy to .env in the project root if you need to change something.
# These are PUBLIC build-time values. Never put API keys, secrets or tokens in VITE_* variables.

# Until the migration reaches the Express cut-over the frontend talks to the legacy FastAPI backend:
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# After the cut-over:
# VITE_API_BASE_URL=http://localhost:4000/api

# Show the complete sample dataset on the dashboard (matches the design mock-up) instead of live data.
VITE_DASHBOARD_DEMO=false

# Roll back to the previous sidebar/topbar and dashboard if something looks wrong.
VITE_LEGACY_SHELL=false
